                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <!-- Dynamic badge color -->
                            <t t-if="record.result.raw_value == 'pass'">
                                <span class="badge text-bg-success">
                    ✅ Pass
                                </span>
                            </t>
                            <t t-elif="record.result.raw_value == 'fail'">
                                <span class="badge text-bg-danger">
                    ❌ Fail
                                </span>
                            </t>
                            <t t-else="">
                                <span class="badge text-bg-secondary">
                    ⏳ Pending
                                </span>
                            </t>
                        </div>
                        <div class="text-muted">
            🔍                            <field name="inspector_id"/>
                        </div>
                        <footer>
                            <field name="check_date"/>
                            <field name="state" widget="label_selection" options="{'classes': {
                    'draft': 'info',
                    'hod': 'warning',
                    'md': 'primary',
                    'approved': 'success'
                }}" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_quality_check_search" model="ir.ui.view">
        <field name="name">quality.check.search</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <search string="Search Quality Checks">
                <field name="name" string="Reference"/>
                <field name="inspector_id"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_pass" string="Passed" domain="[('result', '=', 'pass')]"/>
                <filter name="filter_fail" string="Failed" domain="[('result', '=', 'fail')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_inspector" string="Inspector" context="{'group_by': 'inspector_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_date" string="Check Date" context="{'group_by': 'check_date'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
