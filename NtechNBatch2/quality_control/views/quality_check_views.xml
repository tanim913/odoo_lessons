<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_check_tree" model="ir.ui.view">
        <field name="name">quality.check.tree</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <list string="Quality Checks" default_order="check_date desc" decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                <field name="name" decoration-bf="1"/>
                <field name="inspector_id"/>
                <field name="check_date"/>
                <field name="result"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'hod'" decoration-primary="state == 'md'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_quality_check_form" model="ir.ui.view">
        <field name="name">quality.check.form</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <form string="Quality Check">
                <header>
                    <button name="action_confirm" string="Send to HOD" type="object" class="btn-primary" invisible="state != 'draft'"/>

                    <button name="action_done" string="Approve" type="object" class="btn-success" invisible="state != 'md'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,hod,md,approved,confirmed"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Inspector Info">
                            <field name="inspector_id"/>
                            <field name="additional_inspector_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Check Details">
                            <field name="check_date"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks" placeholder="Enter remarks..."/>
                    </group>
                    <notebook>
                        <page string="Report Notes">
                            <field name="report_note" placeholder="Enter notes to appear on the PDF report..."/>
                        </page>
                        <page string="Product Lines" name="product_lines">
                            <field name="quantity_lines">
                                <list string="Product Lines" editable="top">
                                    <field name="product_id"/>
                                    <field name="rec_qty"/>
                                    <field name="damage_qty"/>
                                    <field name="remain_qty"/>
                                    <field name="line_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">list,form,calendar,kanban</field>
    </record>

    <record id="view_quality_check_calendar" model="ir.ui.view">
        <field name="name">quality.check.calendar</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <calendar string="Quality Checks" date_start="check_date" color="result" mode="month" quick_create="0">
                <field name="name"/>
                <field name="inspector_id"/>
                <field name="result"/>
                <field name="remarks"/>
            </calendar>
        </field>
    </record>

    <record id="view_quality_check_kanban" model="ir.ui.view">
        <field name="name">quality.check.kanban</field>
        <field name="model">quality.check</field>
