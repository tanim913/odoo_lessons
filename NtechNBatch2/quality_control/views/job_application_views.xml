<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_quality_job_application_tree" model="ir.ui.view">
        <field name="name">quality.job.application.tree</field>
        <field name="model">quality.job.application</field>
        <field name="arch" type="xml">
            <list string="Job Applications">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'review'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"/>
                <field name="create_date" string="Applied On"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_quality_job_application_form" model="ir.ui.view">
        <field name="name">quality.job.application.form</field>
        <field name="model">quality.job.application</field>
        <field name="arch" type="xml">
            <form string="Job Application">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,accepted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Applicant Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="create_date" string="Applied On" readonly="1"/>
                            <field name="resume_name" invisible="1"/>
                            <field name="resume" filename="resume_name" widget="binary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_quality_job_application" model="ir.actions.act_window">
        <field name="name">Job Applications</field>
        <field name="res_model">quality.job.application</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No job applications found.
            </p>
            <p>
                Applications submitted from the website will appear here.
            </p>
        </field>
    </record>
</odoo>
